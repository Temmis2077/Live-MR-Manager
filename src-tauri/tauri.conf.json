{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OSW",
  "version": "1.0.0-beta.1",
  "identifier": "com.osw.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run prepare:runtime && npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "OSW — Open Stem Wave",
        "width": 1319,
        "height": 787,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "scope": [
          "$APPDATA/**",
          "$LOCALAPPDATA/**",
          "**"
        ]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["osw", "live-mr-manager"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "runtime/onnxruntime.dll": "onnxruntime.dll",
      "runtime/onnxruntime_providers_shared.dll": "onnxruntime_providers_shared.dll",
      "runtime/onnxruntime_providers_cuda.dll": "onnxruntime_providers_cuda.dll",
      "runtime/onnxruntime_providers_tensorrt.dll": "onnxruntime_providers_tensorrt.dll"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
